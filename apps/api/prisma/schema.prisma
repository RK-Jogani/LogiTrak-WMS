generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id            String   @id @default(cuid())
  legalName     String
  taxId         String?
  logoUrl       String?
  locale        String   @default("en-US")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  warehouses    Warehouse[]
  users         User[]
  billingRules  BillingRule[]
  invoices      Invoice[]
  products      Product[]
  customers     Customer[]
  transactions  Transaction[]
  auditLogs     AuditLog[]
  subscriptions Subscription[]
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  firstName     String
  lastName      String
  password      String?
  role          Role       @default(OPERATOR)
  status        UserStatus @default(ACTIVE)
  mfaEnabled    Boolean    @default(false)
  mfaSecret     String?
  lastLogin     DateTime?
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id])
  assignedZone  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([email, companyId])
}

enum Role {
  ADMIN
  SUPERVISOR
  MANAGER
  OPERATOR
  ACCOUNTANT
  READ_ONLY
  SAAS_SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model Warehouse {
  id          String   @id @default(cuid())
  name        String
  address     String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  zones       Zone[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Zone {
  id            String       @id @default(cuid())
  name          String
  warehouseId   String
  warehouse     Warehouse    @relation(fields: [warehouseId], references: [id])
  locations     Location[]
  template      ZoneTemplate @default(STANDARD_3PL)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum ZoneTemplate {
  STANDARD_3PL
  ECOMMERCE
  CROSS_DOCK
  CUSTOM
}

model Location {
  id          String         @id @default(cuid())
  barcode     String         @unique
  zoneId      String
  zone        Zone           @relation(fields: [zoneId], references: [id])
  capacity    Int            @default(100)
  currentFill Int            @default(0)
  status      LocationStatus @default(AVAILABLE)
  items       InventoryItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

enum LocationStatus {
  AVAILABLE
  OCCUPIED
  FULL
  BLOCKED
  MAINTENANCE
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?
  category    String
  barcode     String?  @unique
  owner       String?
  weight      Float
  length      Float?
  width       Float?
  height      Float?
  isHazmat    Boolean  @default(false)
  storageRules String?
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  inventory   InventoryItem[]
  orderLines  OrderLine[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventoryItem {
  id          String          @id @default(cuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  locationId  String
  location    Location        @relation(fields: [locationId], references: [id])
  quantity    Int             @default(0)
  status      InventoryStatus @default(AVAILABLE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([productId, locationId])
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  BLOCKED
  DAMAGED
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  channel     String
  customer    String
  status      OrderStatus @default(NEW)
  dueDate     DateTime?
  items       OrderLine[]
  shipments   Shipment[]
  returns     ReturnOrder[]
  companyId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum OrderStatus {
  NEW
  ALLOCATED
  PICKING
  PACKED
  SHIPPED
  DELIVERED
  EXCEPTION
}

model OrderLine {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id])
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  quantity          Int
  allocatedLocation String?
  status            OrderLineStatus @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

enum OrderLineStatus {
  PENDING
  ALLOCATED
  PICKED
  CANCELLED
}

model Shipment {
  id             String         @id @default(cuid())
  trackingNumber String         @unique
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id])
  carrier        String
  service        String
  status         ShipmentStatus @default(LABEL_CREATED)
  weight         Float
  dimensions     String?
  labelUrl       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

enum ShipmentStatus {
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  EXCEPTION
}

model BillingRule {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  trigger     String
  unit        String
  rate        Float
  type        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  total         Float
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime
  sentAt        DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  status      String   @default("PROSPECT") // PROSPECT, CUSTOMER, INACTIVE
  notes       String?
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReturnOrder {
  id               String       @id @default(cuid())
  returnNumber     String       @unique
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id])
  status           ReturnStatus @default(PENDING)
  inspectionNotes  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  items            ReturnLine[]
}

enum ReturnStatus {
  PENDING
  RECEIVED
  INSPECTED
  COMPLETED
  REJECTED
}

model ReturnLine {
  id            String   @id @default(cuid())
  returnOrderId String
  returnOrder   ReturnOrder @relation(fields: [returnOrderId], references: [id])
  productId     String
  quantity      Int
  condition     String   @default("UNINSPECTED") // UNINSPECTED, RESTOCKED, DAMAGED, SCRAP
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Transaction {
  id            String   @id @default(cuid())
  type          String   // INCOME, EXPENSE, TAX, BILLING
  amount        Float
  description   String
  category      String
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  action        String
  entity        String
  entityId      String?
  details       String?
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  createdAt     DateTime @default(now())
}

model Subscription {
  id            String   @id @default(cuid())
  tier          String   @default("STARTER") // STARTER, PROFESSIONAL, ENTERPRISE
  status        String   @default("ACTIVE") // ACTIVE, SUSPENDED, TRIAL
  maxWarehouses Int      @default(1)
  maxUsers      Int      @default(5)
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

